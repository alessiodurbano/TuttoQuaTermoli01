# ---------------------------------------------------------------------------
# Copia questo file in `server/.env` e compila i valori.
#   cp server/.env.example server/.env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origine del frontend autorizzata a chiamare le API (CORS).
# Più origini separate da virgola. In produzione: https://www.tuttoqua.it
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# SQLite in locale. In produzione, per PostgreSQL:
#   DATABASE_URL="postgresql://user:password@host:5432/tuttoqua?schema=public"
# (ricordati di cambiare anche `provider` in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# --- Sicurezza --------------------------------------------------------------
# OBBLIGATORIO cambiarli in produzione. Genera valori casuali con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiami-con-una-stringa-casuale-lunga
IP_HASH_SALT=cambiami-con-un-altro-valore-casuale

# Primo account admin, creato dal seed (`npm run db:seed`)
ADMIN_EMAIL=admin@tuttoqua.it
ADMIN_PASSWORD=CambiaQuestaPassword123!

# --- Upload CV --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_CV_SIZE_MB=5

# --- Conservazione dati (GDPR: solo per il tempo necessario) -----------------
# Giorni dopo i quali i record vengono cancellati automaticamente.
RETENTION_DAYS_LEADS=730
RETENTION_DAYS_APPLICATIONS=365
RETENTION_DAYS_CONSENTS=365

# Versione corrente dell'informativa privacy/cookie: incrementala quando
# modifichi i testi, così i consensi precedenti risultano da rinnovare.
PRIVACY_VERSION=1.0

# --- Notifiche email (opzionale) --------------------------------------------
# Se SMTP_HOST è vuoto, le notifiche vengono solo stampate a console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TuttoQua <no-reply@tuttoqua.it>"
MAIL_TO_FRANCHISING=franchising@tuttoqua.it
MAIL_TO_JOBS=info@tuttoqua.it
