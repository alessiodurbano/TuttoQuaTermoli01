{
  "name": "tuttoqua",
  "version": "1.0.0",
  "private": true,
  "description": "Sito TuttoQua — Termoli (CB). React frontend + Node/Express backend.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "setup": "npm install && npm run db:setup --workspace=server",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "typecheck": "npm run typecheck --workspace=client && npm run typecheck --workspace=server",
    "start": "npm run start --workspace=server",
    "db:studio": "npm run db:studio --workspace=server",
    "db:reset": "npm run db:reset --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
